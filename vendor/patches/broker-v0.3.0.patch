+                "name",
+                "value"
+              ],
+              "additionalProperties": true
+            },
+            {
+              "type": "null"
+            }
+          ]
+        },
+        "sample_rows": {
+          "type": "object",
+          "properties": {
+            "total": {
+              "type": "integer",
+              "minimum": 0
+            },
+            "train": {
+              "type": "integer",
+              "minimum": 0
+            },
+            "validation": {
+              "type": "integer",
+              "minimum": 0
+            },
+            "test": {
+              "type": "integer",
+              "minimum": 0
+            }
+          },
+          "required": [
+            "total",
+            "train",
+            "validation",
+            "test"
+          ],
+          "additionalProperties": true
+        }
+      },
+      "required": [
+        "sample_rows"
+      ],
+      "additionalProperties": true
+    }
+  },
+  "required": [
+    "protocol_version",
+    "event_type",
+    "execution_id",
+    "timestamp"
+  ],
+  "additionalProperties": true,
+  "not": {
+    "required": [
+      "job_id"
+    ]
+  },
+  "allOf": [
+    {
+      "if": {
+        "properties": {
+          "event_type": {
+            "const": "LOG"
+          }
+        }
+      },
+      "then": {
+        "required": [
+          "level",
+          "message"
+        ]
+      }
+    },
+    {
+      "if": {
+        "properties": {
