+          }
+        }
+      },
+      "then": {
+        "required": [
+          "phase",
+          "error_code",
+          "error_message",
+          "duration_seconds"
+        ]
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "event_type": {
+            "const": "CANCELLED"
+          }
+        }
+      },
+      "then": {
+        "required": [
+          "phase",
+          "duration_seconds",
+          "processed_rows",
+          "result_rows",
+          "total_rows",
+          "percent",
+          "stop_reason"
+        ]
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "event_type": {
+            "const": "STARTED"
+          }
+        }
+      },
+      "then": {
+        "required": [
+          "total_rows"
+        ]
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "event_type": {
+            "const": "PROGRESS"
+          }
+        }
+      },
+      "then": {
+        "required": [
+          "phase",
+          "processed_rows",
+          "result_rows",
+          "total_rows",
+          "percent"
+        ]
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "event_type": {
+            "const": "COMPLETED"
+          }
+        }
+      },
+      "then": {
+        "required": [
+          "phase",
+          "processed_rows",
+          "result_rows",
+          "total_rows",
+          "percent",
+          "duration_seconds"
+        ],
+        "properties": {
+          "phase": {
+            "const": "CLEANUP"
+          },
+          "percent": {
+            "const": 100
+          }
+        }
+      }
+    }
+  ]
+}
