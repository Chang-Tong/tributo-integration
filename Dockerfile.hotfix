# Build the local KnoVa Wheel first: uv build --wheel.
# Replace all project packages so Consumer and Ray use the same current Core.
ARG BASE_IMAGE=knova-tributo-devbox:v2.8-protocol
FROM ${BASE_IMAGE}
USER root

COPY dist/tributo_knova-0.3.0-py3-none-any.whl /tmp/current-wheels/
COPY vendor/wheels/*.whl /tmp/current-wheels/
COPY deploy/clean_project_packages.py /tmp/clean_project_packages.py
COPY deploy/verify_image.py /opt/tributo-runtime/verify_image.py
RUN set -eu; \
    /opt/tributo-knova/bin/python -m ensurepip --upgrade; \
    /opt/tributo-knova/bin/python /tmp/clean_project_packages.py; \
    /opt/tributo-knova/bin/python -m pip install --no-deps --no-index /tmp/current-wheels/*.whl; \
    site_packages="$(/opt/tributo-knova/bin/python -c \
        'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    rm -rf /opt/tributo-runtime/core/tributo; \
    cp -a "$site_packages/tributo" /opt/tributo-runtime/core/tributo; \
    for package in tributo_knova tributo_broker_redis tributo_algorithms_boosting; do \
        rm -rf "/opt/tributo-runtime/extensions/$package"; \
        cp -a "$site_packages/$package" "/opt/tributo-runtime/extensions/$package"; \
    done; \
    rm -rf /tmp/current-wheels /tmp/clean_project_packages.py; \
    /opt/tributo-knova/bin/python /opt/tributo-runtime/verify_image.py

ARG RELEASE_VERSION=0.3.0-current-core
LABEL org.opencontainers.image.version="${RELEASE_VERSION}"
USER tributo-knova
